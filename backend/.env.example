# ===== Application =====
APP_NAME="Vehicle Tracking API"
DEBUG=true

# ===== Database (PostgreSQL) =====
# Local docker compose default:
DATABASE_URL=postgresql+asyncpg://tracking:tracking@localhost:5432/tracking

# ===== JWT / Auth =====
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-secret-key-change-me-0123456789abcdef-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== MQTT (local Mosquitto via docker compose) =====
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=fleet

# ===== GPS status derivation =====
GPS_STALENESS_SECONDS=60
MOVING_SPEED_KMH=5

# ===== Simulator (cloud demo only - decision #22) =====
SIMULATOR_ENABLED=false
SIMULATOR_INTERVAL_SECONDS=2
